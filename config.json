{
    "sqlserver": {
        "alignLimit": 5.0,
        "executable": "sqlcmd",
        "args": {
            "-S": "<server>",
            "-d": "<database>",
            "-i": "<file>",
            "-s": "\"<delimiter>\"",
            "-W": null,
            "-I": null,
            "-f": 65001
        },
        "actions":{
            "args": {
                "-m":1,
                "-h":-1,
                "-v": "object=\"<object>\""
            },
            "Catalog": {
                "masterDB": "master",
                "GetDatabases": {"file":"GetDatabases.sql"},
                "GetDatabaseObjects": {"file":"GetDBObjects.sql"}
            },
            "Tables": {
                "Preview": {"order": 1, "file": "SelectStar.sql"},
                "Select":  {"order": 2, "file": "Select.sql"},
                "Insert":  {"order": 3, "file": "Insert.sql"},
                "Update":  {"order": 4, "file": "Update.sql"},
                "Create":  {"order": 5, "file": "CreateTable.sql"}
            },
            "Views": {
                "Preview": {"order": 1, "file": "SelectStar.sql"},
                "Select":  {"order": 2, "file": "Select.sql"},
                "Create":  {"order": 3, "file": "TSqlText.sql"}
            },
            "Stored Procedures": {
                "Create":  {"order": 1, "file": "TSqlText.sql"},
                "Execute": {"order": 2, "file": "ExecuteProc.sql"}
            },
            "Scalar Functions": {
                "Create":  {"order": 1, "file": "TSqlText.sql"}
            },
            "Table-valued Functions": {
                "Create":  {"order": 1, "file": "TSqlText.sql"}
            }
        }
    },
    "postgres": {
        "alignLimit": 5.0,
        "executable": "psql",
        "args": {
            "-h": "<server>",
            "-d": "<database>",
            "-f": "<file>",
            "-F": "\"<delimiter>\"",
            "-A": null
        },
        "actions":{
            "args": {"-t": null, "-v": "object=\"<object>\""},
            "Catalog": {
                "masterDB": "postgres",
                "GetDatabases": {"file":"GetDatabases.sql"},
                "GetDatabaseObjects": {"file":"GetDBObjects.sql"}
            },
            "Tables": {
                "Preview": {"order": 1, "file": "SelectStar.sql"},
                "Select":  {"order": 2, "file": "Select.sql"},
                "Insert":  {"order": 3, "file": "Insert.sql"},
                "Update":  {"order": 4, "file": "Update.sql"}
            },
            "Views": {
                "Preview": {"order": 1, "file": "SelectStar.sql"},
                "Select":  {"order": 2, "file": "Select.sql"}
            }
        }
    }
}
